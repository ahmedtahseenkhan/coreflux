# --- Contact form email delivery (optional) ---
# Without these set, the "I'm looking for" form opens the visitor's email client
# pre-addressed to Info@corefluxsolutions.com. Set these to send server-side
# instead (no visitor mail client needed).

# Inbox that receives every enquiry (defaults to Info@corefluxsolutions.com)
CONTACT_TO=Info@corefluxsolutions.com

# SMTP credentials for the mailbox that sends the notification.
# Example for a typical provider:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=Info@corefluxsolutions.com
# Never put a real password in this committed template — set it in .env.local
SMTP_PASS=your-smtp-app-password
# Optional "From" header (defaults to "Coreflux Website <SMTP_USER>")
SMTP_FROM=Coreflux <Info@corefluxsolutions.com>
